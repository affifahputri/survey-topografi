<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Survey Topografi (GPS + BLE)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#800020"
            android:layout_marginBottom="16dp" />

        <!-- Kotak 1: Info Titik Ketinggian & GPS HP Sendiri -->
        <TextView
            android:id="@+id/tvMyLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="Data GPS HP Ini:\nLatitude: -\nLongitude: -\nTitik Ketinggian (Altitude): - mdpl"
            android:textSize="14sp"
            android:textColor="#212529"
            android:layout_marginBottom="12dp" />

        <!-- Tombol 1: Nyalakan BLE -->
        <Button
            android:id="@+id/btnToggleSurvey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#800020"
            android:text="Mulai Scan &amp; Broadcast BLE"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <!-- Kotak 2: Daftar HP Teman yang Terdeteksi via BLE -->
        <TextView
            android:id="@+id/tvPeerList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="Perangkat BLE Terdeteksi:\nBelum ada HP sekitar (Butuh minimal 2 HP teman)"
            android:textSize="14sp"
            android:textColor="#212529"
            android:layout_marginBottom="12dp" />

        <!-- Tombol 2: Hitung Trilaterasi -->
        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#198754"
            android:text="Hitung Trilaterasi (3 HP)"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <!-- Kotak 3: Hasil Perhitungan Akhir -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E8F5E9"
            android:padding="14dp"
            android:text="Hasil Trilaterasi:\n-"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1B5E20" />

    </LinearLayout>
</ScrollView>