<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F8F9FA"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Survey Topografi BLE"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#800020"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pilih peran perangkat ini di lapangan:"
        android:textSize="14sp"
        android:textColor="#495057"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Status Sensor/Izin -->
    <TextView
        android:id="@+id/tvStatusPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="14dp"
        android:text="Status Izin Sensor: Mengecek..."
        android:textSize="13sp"
        android:textColor="#212529"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Tombol Mode Anchor -->
    <Button
        android:id="@+id/btnModeAnchor"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#800020"
        android:text="Mode Anchor (Patokan Diam)"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <!-- Tombol Mode Rover -->
    <Button
        android:id="@+id/btnModeRover"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#198754"
        android:text="Mode Rover (Alat Ukur Keliling)"
        android:textSize="16sp"
        android:textColor="#FFFFFF" />

</LinearLayout>