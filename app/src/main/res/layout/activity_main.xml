<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <!-- Logo Aplikasi -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/logo_topografi" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Survey Topografi"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:letterSpacing="-0.02"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sistem Pemetaan &amp; Trilaterasi BLE"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:layout_marginBottom="36dp" />

        <!-- Card Status dengan Sudut Melengkung Halus -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@android:drawable/presence_online"
                        android:layout_marginRight="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status Sensor &amp; GPS"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#94A3B8"
                        android:letterSpacing="0.05"
                        android:textAllCaps="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStatusPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Memeriksa kesiapan perangkat..."
                    android:textSize="13sp"
                    android:textColor="#334155"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tombol Menu Utama dengan Sudut Melengkung Modern -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeAnchor"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Mode Anchor (Titik Patokan)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            app:backgroundTint="#1E3A8A"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeRover"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Mode Rover (Alat Ukur)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            app:backgroundTint="#047857"
            app:cornerRadius="16dp"
            app:elevation="0dp" />

    </LinearLayout>
</ScrollView>