<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Card Mode Rover -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#047857">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MODE ROVER (3 HP: 2 ANCHOR + 1 ROVER)"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"
                    android:textColor="#A7F3D0"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alat Ukur Lapangan &amp; Trilaterasi"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Kotak 1: Sensor Barometer & GPS -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <TextView
                android:id="@+id/tvRoverGps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Sensor Rover:\n• Elevasi Barometer (z): - mdpl\n• GPS Referensi Arah: -"
                android:textSize="13sp"
                android:textColor="#0F172A"
                android:lineSpacingExtra="3dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Tombol Scan BLE -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanBle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Mulai Scan Sinyal Anchor (BLE)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            app:backgroundTint="#1E3A8A"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            android:layout_marginBottom="12dp" />

        <!-- Kotak 2: Daftar Anchor Terdeteksi -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <TextView
                android:id="@+id/tvDetectedAnchors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Anchor BLE Terdeteksi:\nBelum ada sinyal Anchor..."
                android:textSize="13sp"
                android:textColor="#0F172A"
                android:lineSpacingExtra="3dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Koordinat Anchor 1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Koordinat Patokan Anchor 1 (Otomatis via BLE / Manual):"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#1E3A8A"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <EditText
                android:id="@+id/etA1Lat"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:hint="Lat A1"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:inputType="numberSigned|numberDecimal"
                android:padding="10dp"
                android:textSize="13sp"
                android:layout_marginEnd="6dp" />
            <EditText
                android:id="@+id/etA1Lon"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:hint="Lon A1"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:inputType="numberSigned|numberDecimal"
                android:padding="10dp"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Koordinat Anchor 2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Koordinat Patokan Anchor 2 (Otomatis via BLE / Manual):"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#1E3A8A"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <EditText
                android:id="@+id/etA2Lat"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:hint="Lat A2"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:inputType="numberSigned|numberDecimal"
                android:padding="10dp"
                android:textSize="13sp"
                android:layout_marginEnd="6dp" />
            <EditText
                android:id="@+id/etA2Lon"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:hint="Lon A2"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:inputType="numberSigned|numberDecimal"
                android:padding="10dp"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFillDummyAnchor"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Isi Otomatis Koordinat Sekitar (Simulasi)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            app:backgroundTint="#64748B"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            android:layout_marginBottom="10dp" />

        <!-- Tombol Hitung Trilaterasi -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalculateTrilateration"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Hitung Posisi Trilaterasi (x, y, z)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            app:backgroundTint="#047857"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            android:layout_marginBottom="12dp" />

        <!-- Kotak 3: Hasil Trilaterasi -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#D1E7DD"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tvTrilaterationResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Hasil Perhitungan Trilaterasi:\n-"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0F5132"
                android:lineSpacingExtra="4dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Tombol Simpan Titik & Ekspor CSV -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSavePoint"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Simpan Titik"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                app:backgroundTint="#1E3A8A"
                app:cornerRadius="14dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportCsv"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Ekspor CSV"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                app:backgroundTint="#0F766E"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <!-- Daftar Titik Survey Tersimpan -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <TextView
                android:id="@+id/tvSavedPoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Daftar Titik Survey Tersimpan (0 titik):\nBelum ada titik yang disimpan."
                android:textSize="12sp"
                android:textColor="#334155"
                android:lineSpacingExtra="3dp" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>