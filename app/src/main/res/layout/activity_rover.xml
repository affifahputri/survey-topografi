<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Card Mode Rover -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#047857">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MODE ROVER"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    android:textColor="#A7F3D0"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alat Ukur Lapangan &amp; Trilaterasi"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Kotak 1: GPS & Ketinggian HP Rover -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <TextView
                android:id="@+id/tvRoverGps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="GPS Rover (Titik 3):\nLatitude: -\nLongitude: -\nKetinggian (z): - mdpl"
                android:textSize="13sp"
                android:textColor="#0F172A"
                android:lineSpacingExtra="3dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Tombol Scan BLE -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanBle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Mulai Scan Sinyal Anchor (BLE)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            app:backgroundTint="#1E3A8A"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            android:layout_marginBottom="12dp" />

        <!-- Kotak 2: Daftar Anchor Terdeteksi -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <TextView
                android:id="@+id/tvDetectedAnchors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Anchor BLE Terdeteksi:\nBelum ada sinyal Anchor..."
                android:textSize="13sp"
                android:textColor="#0F172A"
                android:lineSpacingExtra="3dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Panel Input Koordinat Anchor -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Koordinat Patokan Anchor 1 (Lat, Lon):"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#1E3A8A"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <EditText
                android:id="@+id/etA1Lat"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:hint="Lat A1"
                android:inputType="numberSigned|numberDecimal"
                android:padding="10dp"
                android:textSize="13sp"
                android:layout_marginEnd="6dp" />
            <EditText
                android:id="@+id/etA1Lon"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:hint="Lon A1"
                android:inputType="numberSigned|numberDecimal"
                android:padding="10dp"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Koordinat Patokan Anchor 2 (Lat, Lon):"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#1E3A8A"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <EditText
                android:id="@+id/etA2Lat"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:hint="Lat A2"
                android:inputType="numberSigned|numberDecimal"
                android:padding="10dp"
                android:textSize="13sp"
                android:layout_marginEnd="6dp" />
            <EditText
                android:id="@+id/etA2Lon"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:hint="Lon A2"
                android:inputType="numberSigned|numberDecimal"
                android:padding="10dp"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFillDummyAnchor"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Isi Otomatis Koordinat Sekitar (Simulasi)"
            android:textSize="12sp"
            android:textAllCaps="false"
            app:backgroundTint="#64748B"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            android:layout_marginBottom="14dp" />

        <!-- Tombol Hitung Trilaterasi -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalculateTrilateration"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Hitung Posisi Trilaterasi (x, y, z)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            app:backgroundTint="#047857"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            android:layout_marginBottom="14dp" />

        <!-- Kotak 3: Hasil Trilaterasi -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#D1E7DD"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tvTrilaterationResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Hasil Perhitungan Trilaterasi:\n-"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0F5132"
                android:lineSpacingExtra="4dp" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>